## main.js

```js
import { n as common, t as c1 } from "./c1.js";
//#region c2.js
const c2 = `c2:${c1}`;
//#endregion
//#region c3.js
const c3 = `c3:${c2}`;
//#endregion
//#region main.js
const routes = [
	() => import("./r1.js"),
	() => import("./r2.js"),
	() => import("./r3.js")
];
console.log([
	common,
	c1,
	c2,
	c3
].join("|"));
globalThis.fixtureLoadRoute = (route) => routes[route - 1]();
//#endregion
export { c2 as n, c3 as t };

```

